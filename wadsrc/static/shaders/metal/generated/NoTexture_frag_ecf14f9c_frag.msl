            return 0.625 + x;
        }
    }
    else
    {
        float y = (dir.y / dir.x) * 0.125;
        if (dir.x >= 0.0)
        {
            return 0.375 - y;
        }
        else
        {
            return 0.875 - y;
        }
    }
}

