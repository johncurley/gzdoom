    float4 padding3;
};

struct StreamUBO
{
    StreamData data[170];
};

struct MatricesUBO
{
    float4x4 ModelMatrix;
    float4x4 NormalModelMatrix;
    float4x4 TextureMatrix;
};

struct LightBufferSSO
{
    float4 lights[1];
};

struct BoneBufferSSO
{
    float4x4 bones[1];
};

struct main0_out
{
    float4 FragColor [[color(0)]];
    float4 FragFog [[color(1)]];
    float4 FragNormal [[color(2)]];
};

struct main0_in
{
    float4 pixelpos [[user(locn2)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant ViewpointUBO& _40 [[buffer(17)]], constant StreamUBO& _63 [[buffer(20)]], constant PushConstants& _10 [[buffer(21)]])
{
    main0_out out = {};
    float fogdist;
    if (int(_10.group3.z) == (-1))
    {
        fogdist = in.pixelpos.w;
    }
    else
    {
        fogdist = fast::max(16.0, distance(in.pixelpos.xyz, _40.uCameraPos.xyz));
    }
    float fogfactor = exp2(_10.group2.y * fogdist);
    out.FragColor = float4(_63.data[int(_10.group4.y)].uFogColor.xyz, 1.0 - fogfactor);
    out.FragFog = float4(0.0, 0.0, 0.0, 1.0);
    out.FragNormal = float4(0.5, 0.5, 0.5, 1.0);
    return out;
}

