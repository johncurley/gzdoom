#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Uniforms
{
    float2 ReciprocalResolution;
    float Padding0;
    float Padding1;
};

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 TexCoord [[user(locn0)]];
};

static inline __attribute__((always_inline))
float FxaaLuma(thread const float4& rgba)
{
    return rgba.w;
}

static inline __attribute__((always_inline))
float4 FxaaPixelShader(thread const float2& pos, texture2d<float> tex, sampler texSmplr, thread const float2& fxaaQualityRcpFrame, thread const float& fxaaQualitySubpix, thread const float& fxaaQualityEdgeThreshold, thread const float& fxaaQualityEdgeThresholdMin)
{
    float2 posM;
    posM.x = pos.x;
    posM.y = pos.y;
    float4 rgbyM = tex.sample(texSmplr, posM, level(0.0));
    float4 luma4A = tex.gather(texSmplr, posM, int2(0), component::w);
    float4 luma4B = tex.gather(texSmplr, posM, int2(-1), component::w);
    float maxSM = fast::max(luma4A.x, rgbyM.w);
    float minSM = fast::min(luma4A.x, rgbyM.w);
    float maxESM = fast::max(luma4A.z, maxSM);
    float minESM = fast::min(luma4A.z, minSM);
    float maxWN = fast::max(luma4B.z, luma4B.x);
    float minWN = fast::min(luma4B.z, luma4B.x);
    float rangeMax = fast::max(maxWN, maxESM);
    float rangeMin = fast::min(minWN, minESM);
    float rangeMaxScaled = rangeMax * fxaaQualityEdgeThreshold;
    float range = rangeMax - rangeMin;
    float rangeMaxClamped = fast::max(fxaaQualityEdgeThresholdMin, rangeMaxScaled);
    bool earlyExit = range < rangeMaxClamped;
    if (earlyExit)
    {
        return rgbyM;
    }
    float4 param = tex.sample(texSmplr, posM, level(0.0), int2(1, -1));
    float lumaNE = FxaaLuma(param);
    float4 param_1 = tex.sample(texSmplr, posM, level(0.0), int2(-1, 1));
    float lumaSW = FxaaLuma(param_1);
    float lumaNS = luma4B.z + luma4A.x;
    float lumaWE = luma4B.x + luma4A.z;
    float subpixRcpRange = 1.0 / range;
    float subpixNSWE = lumaNS + lumaWE;
    float edgeHorz1 = ((-2.0) * rgbyM.w) + lumaNS;
    float edgeVert1 = ((-2.0) * rgbyM.w) + lumaWE;
    float lumaNESE = lumaNE + luma4A.y;
    float lumaNWNE = luma4B.w + lumaNE;
    float edgeHorz2 = ((-2.0) * luma4A.z) + lumaNESE;
    float edgeVert2 = ((-2.0) * luma4B.z) + lumaNWNE;
    float lumaNWSW = luma4B.w + lumaSW;
    float lumaSWSE = lumaSW + luma4A.y;
    float edgeHorz4 = (abs(edgeHorz1) * 2.0) + abs(edgeHorz2);
    float edgeVert4 = (abs(edgeVert1) * 2.0) + abs(edgeVert2);
    float edgeHorz3 = ((-2.0) * luma4B.x) + lumaNWSW;
    float edgeVert3 = ((-2.0) * luma4A.x) + lumaSWSE;
    float edgeHorz = abs(edgeHorz3) + edgeHorz4;
    float edgeVert = abs(edgeVert3) + edgeVert4;
    float subpixNWSWNESE = lumaNWSW + lumaNESE;
    float lengthSign = fxaaQualityRcpFrame.x;
    bool horzSpan = edgeHorz >= edgeVert;
    float subpixA = (subpixNSWE * 2.0) + subpixNWSWNESE;
    if (!horzSpan)
    {
        luma4B.z = luma4B.x;
    }
    if (!horzSpan)
    {
        luma4A.x = luma4A.z;
    }
    if (horzSpan)
    {
        lengthSign = fxaaQualityRcpFrame.y;
    }
    float subpixB = (subpixA * 0.083333335816860198974609375) - rgbyM.w;
    float gradientN = luma4B.z - rgbyM.w;
    float gradientS = luma4A.x - rgbyM.w;
    float lumaNN = luma4B.z + rgbyM.w;
    float lumaSS = luma4A.x + rgbyM.w;
    bool pairN = abs(gradientN) >= abs(gradientS);
    float gradient = fast::max(abs(gradientN), abs(gradientS));
    if (pairN)
    {
        lengthSign = -lengthSign;
    }
    float subpixC = fast::clamp(abs(subpixB) * subpixRcpRange, 0.0, 1.0);
    float2 posB;
    posB.x = posM.x;
    posB.y = posM.y;
    float _343;
    if (!horzSpan)
    {
        _343 = 0.0;
    }
    else
    {
        _343 = fxaaQualityRcpFrame.x;
    }
    float2 offNP;
    offNP.x = _343;
    float _352;
    if (horzSpan)
    {
        _352 = 0.0;
    }
    else
    {
        _352 = fxaaQualityRcpFrame.y;
    }
    offNP.y = _352;
    if (!horzSpan)
    {
        posB.x += (lengthSign * 0.5);
    }
    if (horzSpan)
    {
        posB.y += (lengthSign * 0.5);
    }
    float2 posN;
    posN.x = posB.x - (offNP.x * 1.5);
    posN.y = posB.y - (offNP.y * 1.5);
    float2 posP;
    posP.x = posB.x + (offNP.x * 1.5);
    posP.y = posB.y + (offNP.y * 1.5);
    float subpixD = ((-2.0) * subpixC) + 3.0;
    float4 param_2 = tex.sample(texSmplr, posN, level(0.0));
    float lumaEndN = FxaaLuma(param_2);
    float subpixE = subpixC * subpixC;
    float4 param_3 = tex.sample(texSmplr, posP, level(0.0));
    float lumaEndP = FxaaLuma(param_3);
    if (!pairN)
    {
        lumaNN = lumaSS;
    }
    float gradientScaled = (gradient * 1.0) / 4.0;
    float lumaMM = rgbyM.w - (lumaNN * 0.5);
    float subpixF = subpixD * subpixE;
    bool lumaMLTZero = lumaMM < 0.0;
    lumaEndN -= (lumaNN * 0.5);
    lumaEndP -= (lumaNN * 0.5);
    bool doneN = abs(lumaEndN) >= gradientScaled;
    bool doneP = abs(lumaEndP) >= gradientScaled;
    if (!doneN)
    {
        posN.x -= (offNP.x * 3.0);
    }
    if (!doneN)
    {
        posN.y -= (offNP.y * 3.0);
    }
    bool doneNP = (!doneN) || (!doneP);
    if (!doneP)
    {
        posP.x += (offNP.x * 3.0);
    }
    if (!doneP)
    {
        posP.y += (offNP.y * 3.0);
    }
    if (doneNP)
    {
        if (!doneN)
        {
            float4 param_4 = tex.sample(texSmplr, posN, level(0.0));
            lumaEndN = FxaaLuma(param_4);
        }
        if (!doneP)
        {
            float4 param_5 = tex.sample(texSmplr, posP, level(0.0));
            lumaEndP = FxaaLuma(param_5);
        }
        if (!doneN)
        {
            lumaEndN -= (lumaNN * 0.5);
        }
        if (!doneP)
        {
            lumaEndP -= (lumaNN * 0.5);
        }
        doneN = abs(lumaEndN) >= gradientScaled;
        doneP = abs(lumaEndP) >= gradientScaled;
        if (!doneN)
        {
            posN.x -= (offNP.x * 12.0);
        }
        if (!doneN)
        {
            posN.y -= (offNP.y * 12.0);
        }
        doneNP = (!doneN) || (!doneP);
        if (!doneP)
        {
            posP.x += (offNP.x * 12.0);
        }
        if (!doneP)
        {
            posP.y += (offNP.y * 12.0);
        }
    }
    float dstN = posM.x - posN.x;
    float dstP = posP.x - posM.x;
    if (!horzSpan)
    {
        dstN = posM.y - posN.y;
    }
    if (!horzSpan)
    {
        dstP = posP.y - posM.y;
    }
    bool goodSpanN = (lumaEndN < 0.0) != lumaMLTZero;
    float spanLength = dstP + dstN;
    bool goodSpanP = (lumaEndP < 0.0) != lumaMLTZero;
    float spanLengthRcp = 1.0 / spanLength;
    bool directionN = dstN < dstP;
    float dst = fast::min(dstN, dstP);
    bool goodSpan = directionN ? goodSpanN : goodSpanP;
    float subpixG = subpixF * subpixF;
    float pixelOffset = (dst * (-spanLengthRcp)) + 0.5;
    float subpixH = subpixG * fxaaQualitySubpix;
    float pixelOffsetGood = goodSpan ? pixelOffset : 0.0;
    float pixelOffsetSubpix = fast::max(pixelOffsetGood, subpixH);
    if (!horzSpan)
    {
        posM.x += (pixelOffsetSubpix * lengthSign);
    }
    if (horzSpan)
    {
        posM.y += (pixelOffsetSubpix * lengthSign);
    }
    return float4(tex.sample(texSmplr, posM, level(0.0)).xyz, rgbyM.w);
}

fragment main0_out main0(main0_in in [[stage_in]], constant Uniforms& _741 [[buffer(0)]], texture2d<float> InputTexture [[texture(0)]], sampler InputTextureSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 param = in.TexCoord;
    float2 param_1 = _741.ReciprocalResolution;
    float param_2 = 0.75;
    float param_3 = 0.16599999368190765380859375;
    float param_4 = 0.083300001919269561767578125;
    out.FragColor = FxaaPixelShader(param, InputTexture, InputTextureSmplr, param_1, param_2, param_3, param_4);
    return out;
}
