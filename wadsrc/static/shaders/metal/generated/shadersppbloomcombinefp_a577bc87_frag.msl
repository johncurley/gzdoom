#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 TexCoord [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> Bloom [[texture(0)]], sampler BloomSmplr [[sampler(0)]])
{
    main0_out out = {};
    out.FragColor = float4(Bloom.sample(BloomSmplr, in.TexCoord).xyz, 0.0);
    return out;
}
