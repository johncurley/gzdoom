}

static inline __attribute__((always_inline))
float linearizeDepth(thread const float& normalizedDepth, constant Uniforms& _19)
{
    return 1.0 / ((normalizedDepth * _19.LinearizeDepthA) + _19.LinearizeDepthB);
}

fragment main0_out main0(main0_in in [[stage_in]], constant Uniforms& _19 [[buffer(0)]], texture2d<float> DepthTexture [[texture(0)]], texture2d<float> ColorTexture [[texture(1)]], sampler DepthTextureSmplr [[sampler(0)]], sampler ColorTextureSmplr [[sampler(1)]])
