#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Uniforms
{
    float ExposureBase;
    float ExposureMin;
    float ExposureScale;
    float ExposureSpeed;
};

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 TexCoord [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant Uniforms& _27 [[buffer(0)]], texture2d<float> ExposureTexture [[texture(0)]], sampler ExposureTextureSmplr [[sampler(0)]])
{
    main0_out out = {};
    float light = ExposureTexture.sample(ExposureTextureSmplr, in.TexCoord).x;
    float exposureAdjustment = 1.0 / fast::max(_27.ExposureBase + (light * _27.ExposureScale), _27.ExposureMin);
    out.FragColor = float4(exposureAdjustment, 0.0, 0.0, _27.ExposureSpeed);
    return out;
}
