static inline __attribute__((always_inline))
float3 SampleNormal(thread const float2& uv, texture2d<float> NormalTexture, sampler NormalTextureSmplr)
{
    int2 texSize = int2(NormalTexture.get_width(), NormalTexture.get_height());
    int2 ipos = int2(uv * float2(texSize));
    return (NormalTexture.read(uint2(ipos), 0).xyz * 2.0) - float3(1.0);
}

static inline __attribute__((always_inline))
float3 FetchNormal(thread const float2& uv, constant Uniforms& _72, texture2d<float> NormalTexture, sampler NormalTextureSmplr)
{
