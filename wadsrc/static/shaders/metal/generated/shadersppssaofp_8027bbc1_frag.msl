static inline __attribute__((always_inline))
float3 FetchViewPos(thread const float2& uv, texture2d<float> DepthTexture, sampler DepthTextureSmplr, constant Uniforms& _72)
{
    float z = DepthTexture.sample(DepthTextureSmplr, uv).x;
    return float3(((_72.UVToViewA * uv) + _72.UVToViewB) * z, z);
