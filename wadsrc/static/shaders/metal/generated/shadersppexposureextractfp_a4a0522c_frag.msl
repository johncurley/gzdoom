#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Uniforms
{
    float2 Scale;
    float2 Offset;
};

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 TexCoord [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant Uniforms& _18 [[buffer(0)]], texture2d<float> SceneTexture [[texture(0)]], sampler SceneTextureSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 color = SceneTexture.sample(SceneTextureSmplr, (_18.Offset + (in.TexCoord * _18.Scale)));
    out.FragColor = float4(fast::max(fast::max(color.x, color.y), color.z), 0.0, 0.0, 1.0);
    return out;
}
